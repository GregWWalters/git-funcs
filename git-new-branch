#! /usr/bin/env sh

set -e # errexit
. "$(dirname "$0")/helpers"

# Help text
helpTxt() {
	heading 'NAME'
	body "git-new-branch - Create a new branch based on the remote's latest HEAD"

	heading 'SYNOPSIS'
	body "git new-branch [-b <base>] <branch-name> [<remote>]"

	heading 'DESCRIPTION'
	body "Create a new branch with <branch-name> based on the remote's HEAD. If
	<remote> is provided, it will use the primary branch for that remote instead
	of the primary remote. Otherwise, it will first check the repository's
	configuration for the primary remote, and if not found, use the first remote
	associated with the repository. To change the primary remote, use git-refresh
	-s <remote>."
	body "If -b <base> is given, the new branch is based on <base> instead of
	the primary, and branch.<branch-name>.funcsBase is set to <base> to record
	it (used by git resync, git stack, and git sweep). <base> may be:"
	body "a local branch - the new branch is stacked on it, and resync
	restacks the two together;"
	body "any other ref (tag, remote-tracking ref, sha) - a pinned base: the
	new branch starts there and resync rebases it onto that ref rather than
	the primary;"
	body "'none' - the new branch starts from the primary but is pinned with
	no base at all, so resync never rebases it. Use this for a branch that
	must not pick up trunk;"
	body "'.' or '@' - the current branch."
	body "-b cannot be combined with a <remote> argument, except for
	'-b none', whose start point is the primary and so still honours it."

	heading 'OPTIONS'
	option '-b <base>' '(base) Base the new branch on <base> instead of the
		primary, recording it as the branch'\''s base: a local branch stacks on
		it, any other ref pins to it, and '\''none'\'' pins with no base so the
		branch is never rebased. '\''.'\'' or '\''@'\'' means the current branch.'
	option '-s' '(stash) Automatically stash uncommitted changes before checking
	out the branch and pop after'
	option '-q' '(quiet) Suppress writing to stdout. Overrides .gitconfig
		options funcs.verbose and funcs.new-branch.verbose.'
	option '-v' '(verbose) Print additional information'
	option '-h' '(help) Print this help'

	printf '\n'
}

case "$1" in
	"help"|"-help"|"--help")
		helpTxt
		exit 0
		;;
esac

s=0 q=0 v=0 baseArg=""
while getopts ":hsqvb:" opt; do
	case $opt in
		h) helpTxt; exit 0 ;;
		s) s=1 ;;
		q) q=1 v=0; ;;
		v) v=1 ;;
		b) baseArg=$OPTARG ;;
		:)
			echo >&2 "Option \`-$OPTARG\` requires an argument." \
				"Run git new-branch -h for help."
			exit 1
			;;
		\?)
			echo >&2 "Unknown option -$OPTARG. Run git new-branch -h for help."
			exit 1
			;;
	esac
done
shift $(expr $OPTIND - 1)

if [ $q -eq 1 ]; then
	v=0
elif [ $v -eq 1 ] || configValueOn -o -q "verbose" "new-branch"; then
	v=1
fi

branch=$1
if [ -z "$branch" ]; then
	echo >&2 "git new-branch requires 1 argument <new branch name>"
	exit 1
fi

remoteArg=$2

# base is what gets recorded in funcsBase; startPoint is what the branch is
# actually cut from. They differ only for '-b none', which records no base but
# still has to start somewhere - the primary, same as a plain new-branch.
base="" startPoint=""
if [ -n "$baseArg" ]; then
	case "$(printf '%s' "$baseArg" | tr '[:upper:]' '[:lower:]')" in
		none) base="none" ;;
	esac
	if [ -z "$base" ]; then
		case "$baseArg" in
			"."|"@")
				base=$(git branch --show-current 2>/dev/null || :)
				if [ -z "$base" ]; then
					echo >&2 "git new-branch: -b $baseArg requires a checked-out branch (detached HEAD?)."
					exit 1
				fi
				;;
			*)
				base=$baseArg
				;;
		esac
		if git rev-parse --verify --quiet "refs/heads/$base" >/dev/null 2>&1; then
			startPoint=$base
		elif git rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1; then
			startPoint=$base
		else
			echo >&2 "git new-branch: base '$base' does not resolve to a branch or ref."
			exit 1
		fi
	fi
fi

if [ -n "$baseArg" ] && [ "$base" != "none" ] && [ -n "$remoteArg" ]; then
	echo >&2 "git new-branch: -b <base> cannot be combined with a <remote>" \
		"argument (except -b none, which starts from the primary)."
	exit 1
fi

# redirect output of the next block
[ $v -eq 1 ] && exec 4>&1 || exec 4>/dev/null
{
	# Check for uncommitted changes
	modified=$(git status --porcelain -uno | wc -l)
	if [ "$modified" -gt 0 ] && [ $s -eq 0 ]; then
		echo >&2 'There are uncommitted changes. Commit or stash them, or use `-s`' \
			'to stash them automatically.'
		exit 1
	fi
	if [ "$modified" -gt 0 ]; then git stash push; fi
	if [ -n "$startPoint" ]; then
		git checkout "$startPoint"
	else
		git co-primary ${remoteArg:+"$remoteArg"}
	fi
	git checkout -b "$branch"
	if [ -n "$base" ]; then
		git config --local "branch.$branch.funcsBase" "$base"
	fi
	if [ "$modified" -gt 0 ]; then git stash pop; fi
} >&4

