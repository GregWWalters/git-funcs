#! /usr/bin/env sh

set -e # errexit
. "$(dirname "$0")/helpers"

helpTxt() {
	heading 'NAME'
	body 'git-sweep - Delete local branches already merged into the target'

	heading 'SYNOPSIS'
	body 'git sweep [-n] [-w] [-t <target>] [-q|-v]'

	heading 'DESCRIPTION'
	body 'Find and delete local branches whose changes are fully present in the
	target branch. Unlike `git branch --merged`, this detects rebase-merges and
	squash-merges by simulating a merge and comparing the resulting tree.'
	body 'For each deleted branch, prints the branch name and head commit to
	stdout.'
	body 'Branches checked out in worktrees are skipped unless -w is set, in
	which case the worktree is removed first.'

	heading 'OPTIONS'
	option '-n' '(dry-run) Show what would be deleted without deleting.'
	option '-w' '(worktrees) Also remove worktrees for merged branches.'
	option '-t <target>' '(target) Branch or ref to compare against (default:
		primary remote/branch).'
	option '-q' '(quiet) Suppress informational output.'
	option '-v' '(verbose) Print additional information.'
	option '-h' '(help) Print this help.'
}

case "$1" in
	"help"|"-help"|"--help")
		helpTxt
		exit 0
		;;
esac

dryRun=0 wt=0 targetArg="" q=0 v=0
while getopts ":hnwt:qv" opt; do
	case $opt in
		h) helpTxt; exit 0 ;;
		n) dryRun=1 ;;
		w) wt=1 ;;
		t) targetArg=$OPTARG ;;
		q) q=1; v=0 ;;
		v) v=1 ;;
		:)
			echo >&2 "Option \`-$OPTARG\` requires an argument." \
				"Run git sweep -h for help."
			exit 1
			;;
		\?)
			echo >&2 "Unknown option -$OPTARG. Run git sweep -h for help."
			exit 1
			;;
	esac
done
shift $(expr $OPTIND - 1)

if [ $q -eq 1 ]; then
	v=0
elif [ $v -eq 1 ] || configValueOn -o -q "verbose" "sweep"; then
	v=1
fi

# Resolve target
if [ -n "$targetArg" ]; then
	target=$targetArg
else
	target=$(getPrimary -o)
	if [ -z "$target" ]; then
		echo >&2 "No primary branch configured. Use -t <branch> or run git refresh."
		exit 1
	fi
fi

if ! git rev-parse --verify "$target" >/dev/null 2>&1; then
	echo >&2 "Target '$target' does not exist."
	exit 1
fi

target_tree=$(git rev-parse "$target^{tree}")
current=$(git branch --show-current 2>/dev/null || :)

# Derive local branch name from target to avoid deleting it
case "$target" in
	*/*) skip_branch=${target#*/} ;;
	*)   skip_branch=$target ;;
esac

[ $v -eq 1 ] && echo >&2 "target: $target"

# Build worktree map: tab-separated "path\tbranch" for non-main worktrees
main_wt=$(git rev-parse --show-toplevel)
wt_map=$(git worktree list --porcelain | awk -v main="$main_wt" '
	/^worktree / { p = substr($0, 10); is_main = (p == main) }
	/^branch refs\/heads\// && !is_main { print p "\t" substr($0, 19) }
')

git for-each-ref --format='%(refname:short) %(objectname:short)' refs/heads/ | \
while read branch commit; do
	[ "$branch" = "$current" ] && continue
	[ "$branch" = "$skip_branch" ] && continue

	# Simulate merge; conflicts mean the branch is not cleanly merged
	merged_tree=$(git merge-tree --write-tree "$target" "$branch" 2>/dev/null) || {
		[ $v -eq 1 ] && echo >&2 "  skip $branch (merge conflicts)"
		continue
	}

	# If the merged tree differs from target, the branch has unmerged changes
	[ "$merged_tree" = "$target_tree" ] || {
		[ $v -eq 1 ] && echo >&2 "  skip $branch (unmerged changes)"
		continue
	}

	# Check if branch is checked out in a worktree
	wt_path=""
	if [ -n "$wt_map" ]; then
		wt_path=$(printf '%s\n' "$wt_map" | awk -F'\t' -v b="$branch" '$2 == b { print $1; exit }')
	fi

	if [ $dryRun -eq 1 ]; then
		if [ -n "$wt_path" ]; then
			echo "$branch $commit (worktree: $wt_path)"
		else
			echo "$branch $commit"
		fi
		continue
	fi

	if [ -n "$wt_path" ]; then
		if [ $wt -eq 0 ]; then
			[ $q -eq 0 ] && echo >&2 "  skip $branch (in worktree $wt_path; use -w)"
			continue
		fi
		git worktree remove "$wt_path" 2>/dev/null || {
			echo >&2 "  warning: could not remove worktree $wt_path"
			continue
		}
	fi

	if git branch -D "$branch" >/dev/null 2>&1; then
		echo "$branch $commit"
	else
		echo >&2 "  warning: could not delete $branch"
	fi
done
