#! /usr/bin/env sh

set -e # errexit
. "$(dirname "$0")/helpers"

helpTxt() {
	heading 'NAME'
	body 'git-sweep - Delete local branches already merged into the target'

	heading 'SYNOPSIS'
	body 'git sweep [-n] [-w] [-f] [-p|-P] [-t <target>] [-q|-v]'

	heading 'DESCRIPTION'
	body 'Find and delete local branches whose changes are fully present in the
	target branch. Unlike `git branch --merged`, this detects rebase-merges and
	squash-merges by simulating a merge and comparing the resulting tree.'
	body 'The tree comparison only holds while the target still merges the
	branch cleanly. Once the target advances past a squash-merged branch, that
	branch reads as conflicted forever even though every line of it shipped. So
	when the comparison fails, GitHub is asked whether a merged pull request
	exists for the branch; it is swept only if it carries no commits beyond the
	one that was merged. Disable with -P, or `funcs.sweep.pr = false`.'
	body 'For each deleted branch, prints the branch name and head commit to
	stdout.'
	body 'Branches checked out in worktrees are skipped unless -w is set, in
	which case the worktree is removed first. Removal refuses to discard
	untracked files (a stray .idea/ is enough to strand an otherwise merged
	worktree) — use -f to override. With -w, worktrees with a detached HEAD are
	swept too; holding no branch ref, they are otherwise invisible here.'

	heading 'OPTIONS'
	option '-n' '(dry-run) Show what would be deleted without deleting.'
	option '-w' '(worktrees) Also remove worktrees for merged branches, and
		sweep merged detached-HEAD worktrees.'
	option '-f' '(force) Remove worktrees even when they hold uncommitted or
		untracked files. Implies -w.'
	option '-p' '(pull requests) Consult GitHub for squash-merged branches
		(default when `gh` is available).'
	option '-P' '(no pull requests) Compare trees only; never call GitHub.'
	option '-t <target>' '(target) Branch or ref to compare against (default:
		primary remote/branch).'
	option '-q' '(quiet) Suppress informational output.'
	option '-v' '(verbose) Print additional information.'
	option '-h' '(help) Print this help.'
}

case "$1" in
	"help"|"-help"|"--help")
		helpTxt
		exit 0
		;;
esac

dryRun=0 wt=0 force=0 pr=-1 targetArg="" q=0 v=0
while getopts ":hnwfpPt:qv" opt; do
	case $opt in
		h) helpTxt; exit 0 ;;
		n) dryRun=1 ;;
		w) wt=1 ;;
		f) force=1; wt=1 ;;
		p) pr=1 ;;
		P) pr=0 ;;
		t) targetArg=$OPTARG ;;
		q) q=1; v=0 ;;
		v) v=1 ;;
		:)
			echo >&2 "Option \`-$OPTARG\` requires an argument." \
				"Run git sweep -h for help."
			exit 1
			;;
		\?)
			echo >&2 "Unknown option -$OPTARG. Run git sweep -h for help."
			exit 1
			;;
	esac
done
shift $(expr $OPTIND - 1)

if [ $q -eq 1 ]; then
	v=0
elif [ $v -eq 1 ] || configValueOn -o -q "verbose" "sweep"; then
	v=1
fi

# Resolve target
if [ -n "$targetArg" ]; then
	target=$targetArg
else
	target=$(getPrimary -o)
	if [ -z "$target" ]; then
		echo >&2 "No primary branch configured. Use -t <branch> or run git refresh."
		exit 1
	fi
fi

if ! git rev-parse --verify "$target" >/dev/null 2>&1; then
	echo >&2 "Target '$target' does not exist."
	exit 1
fi

current=$(git branch --show-current 2>/dev/null || :)

# Derive local branch name from target to avoid deleting it
case "$target" in
	*/*) skip_branch=${target#*/} ;;
	*)   skip_branch=$target ;;
esac

[ $v -eq 1 ] && echo >&2 "target: $target"

# Resolve the pull-request fallback: explicit flag wins, then config, then on
# by default. Loading is what actually decides — a repo with no GitHub remote
# or no `gh` simply yields an empty map and the tree comparison stands alone.
if [ $pr -eq -1 ]; then
	if configValueOn -o -q "pr" "sweep"; then
		pr=1
	elif [ "$(git config --get --type=bool funcs.sweep.pr || :)" = "false" ]; then
		pr=0
	else
		pr=1
	fi
fi

prMap=""
if [ $pr -eq 1 ]; then
	if prMap=$(loadMergedPrMap); then
		[ $v -eq 1 ] && echo >&2 \
			"merged PRs known to GitHub: $(printf '%s' "$prMap" | grep -c '')"
	else
		prMap=""
		[ $v -eq 1 ] && echo >&2 "no GitHub PR data; comparing trees only"
	fi
fi

# Prune stale worktree metadata (directories removed outside of git)
git worktree prune 2>/dev/null || :

# Build worktree map: tab-separated "path\tbranch" for non-main worktrees
main_wt=$(git rev-parse --show-toplevel)
wt_map=$(git worktree list --porcelain | awk -v main="$main_wt" '
	/^worktree / { p = substr($0, 10); is_main = (p == main) }
	/^branch refs\/heads\// && !is_main { print p "\t" substr($0, 19) }
')

git for-each-ref --format='%(refname:short) %(objectname:short)' refs/heads/ | \
while read branch commit; do
	[ "$branch" = "$current" ] && continue
	[ "$branch" = "$skip_branch" ] && continue

	# Simulate merge; conflicts mean the branch is not cleanly merged, and a
	# differing tree means the branch has unmerged changes. isMergedInto
	# legitimately returns 1/2 for these non-error outcomes, so its status
	# must be captured via `||`, never as a bare statement, under `set -e`.
	mergedStatus=0
	isMergedInto "$target" "$branch" || mergedStatus=$?
	viaPr=0
	if [ $mergedStatus -ne 0 ]; then
		# A squash- or rebase-merged branch stops comparing equal as soon as
		# the target moves on, so a failed comparison is not proof the work is
		# unlanded. Ask GitHub what was actually merged before writing it off.
		prOid=""
		if [ -n "$prMap" ]; then
			prOid=$(printf '%s\n' "$prMap" | \
				awk -F'\t' -v b="$branch" '$1 == b { print $2; exit }')
		fi
		if isMergedViaPR "$prOid" "$branch"; then
			viaPr=1
		elif [ $mergedStatus -eq 2 ]; then
			if [ $v -eq 1 ]; then echo >&2 "  skip $branch (merge conflicts)"; fi
			continue
		else
			if [ $v -eq 1 ]; then echo >&2 "  skip $branch (unmerged changes)"; fi
			continue
		fi
	fi

	# Snapshot the branch's stack base and children before deletion drops
	# its config section
	bBase=$(getBranchBase "$branch")
	bChildren=$(getBranchChildren "$branch")

	# Check if branch is checked out in a worktree
	wt_path=""
	if [ -n "$wt_map" ]; then
		wt_path=$(printf '%s\n' "$wt_map" | awk -F'\t' -v b="$branch" '$2 == b { print $1; exit }')
	fi

	# Why a branch qualified is informational, and belongs on stderr: stdout
	# stays the machine-readable "<branch> <commit>" contract.
	if [ $viaPr -eq 1 ] && [ $q -eq 0 ]; then
		echo >&2 "  $branch: squash/rebase-merged via GitHub PR"
	fi

	if [ $dryRun -eq 1 ]; then
		if [ -n "$wt_path" ]; then
			echo "$branch $commit (worktree: $wt_path)"
		else
			echo "$branch $commit"
		fi
		if [ -n "$bChildren" ] && [ $q -eq 0 ]; then
			for child in $bChildren; do
				if [ -n "$bBase" ]; then
					echo >&2 "  would re-point $child base -> $bBase"
				else
					echo >&2 "  would re-point $child base -> primary"
				fi
			done
		fi
		continue
	fi

	if [ -n "$wt_path" ]; then
		if [ $wt -eq 0 ]; then
			[ $q -eq 0 ] && echo >&2 "  skip $branch (in worktree $wt_path; use -w)"
			continue
		fi
		# Removal refuses while anything untracked or modified is present. -f
		# discards it; without -f, say what is in the way rather than leaving
		# the branch mysteriously unswept.
		rmOk=0
		git worktree remove "$wt_path" 2>/dev/null || rmOk=$?
		if [ $rmOk -ne 0 ] && [ $force -eq 1 ]; then
			rmOk=0
			git worktree remove --force "$wt_path" 2>/dev/null || rmOk=$?
		fi
		if [ $rmOk -ne 0 ]; then
			if [ -d "$wt_path" ]; then
				echo >&2 "  warning: could not remove worktree $wt_path" \
					"($(git -C "$wt_path" status --porcelain 2>/dev/null | \
					grep -c '') local change(s); use -f)"
				continue
			fi
			# Directory already gone (e.g. removed with a parent worktree);
			# prune stale metadata so branch deletion can proceed
			git worktree prune 2>/dev/null || :
		fi
	fi

	if git branch -D "$branch" >/dev/null 2>&1; then
		echo "$branch $commit"
		if [ -n "$bChildren" ]; then
			for child in $bChildren; do
				if [ -n "$bBase" ]; then
					git config --local "branch.$child.funcsBase" "$bBase"
					if [ $q -eq 0 ]; then echo >&2 "  re-pointed $child base -> $bBase"; fi
				else
					git config --local --unset "branch.$child.funcsBase"
					if [ $q -eq 0 ]; then echo >&2 "  re-pointed $child base -> primary"; fi
				fi
			done
		fi
	else
		echo >&2 "  warning: could not delete $branch"
	fi
done

# Detached-HEAD worktrees hold no branch ref, so the refs/heads walk above
# never sees them — they accumulate indefinitely. With nothing but a commit to
# test, the tree comparison is the only signal available (a bare commit has no
# branch name to match a pull request against). Nothing is deleted but the
# worktree itself; the commit stays reachable from the reflog.
if [ $wt -eq 1 ]; then
	git worktree list --porcelain | awk -v main="$main_wt" '
		/^worktree / { p = substr($0, 10) }
		/^detached$/ { if (p != main) print p }
	' | while read -r dPath; do
		[ -d "$dPath" ] || continue
		dHead=$(git -C "$dPath" rev-parse HEAD 2>/dev/null) || continue
		dShort=$(git -C "$dPath" rev-parse --short HEAD 2>/dev/null)

		dStatus=0
		isMergedInto "$target" "$dHead" || dStatus=$?
		if [ $dStatus -ne 0 ]; then
			if [ $v -eq 1 ]; then
				echo >&2 "  skip $dPath (detached, unmerged)"
			fi
			continue
		fi

		if [ $dryRun -eq 1 ]; then
			echo "(detached) $dShort (worktree: $dPath)"
			continue
		fi

		rmOk=0
		git worktree remove "$dPath" 2>/dev/null || rmOk=$?
		if [ $rmOk -ne 0 ] && [ $force -eq 1 ]; then
			rmOk=0
			git worktree remove --force "$dPath" 2>/dev/null || rmOk=$?
		fi
		if [ $rmOk -eq 0 ]; then
			echo "(detached) $dShort (worktree: $dPath)"
		elif [ -d "$dPath" ]; then
			echo >&2 "  warning: could not remove worktree $dPath" \
				"($(git -C "$dPath" status --porcelain 2>/dev/null | \
				grep -c '') local change(s); use -f)"
		fi
	done
fi
