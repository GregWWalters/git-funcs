# git custom command helper functions

testInteger() {
	[ -n "$1" ] && [ "$1" -eq "$1" ] 2>/dev/null
}

termWidth() (
	if command -v stty >/dev/null 2>&1; then
		w=$(stty size 2>/dev/null | cut -d' ' -f2)
	fi
	if [ -z "$w" ] && command -v tput >/dev/null 2>&1; then
		w=$(tput cols 2>/dev/null)
	fi
	testInteger "$w" && [ "$w" -gt 0 ] || return 1
	echo "$w"
)

indent() (
	testInteger $1 || {
		echo >&2 "indent requires number of spaces as the first argument"
		return 1
	}
	space=$1; shift
	[ $# -gt 0 ] || return 0
	maxWidth=$(termWidth) || maxWidth=60
	width=$(expr "$maxWidth" - "$space")
	# Help text is written across several source lines and indented to match
	# the surrounding code, so it arrives carrying the newlines and tabs of
	# that layout — which would otherwise wrap straight into the output.
	# Flatten them first, while the escapes callers embed (\n for a paragraph
	# break, \033 for bold) are still literal backslash pairs, so only real
	# layout whitespace is collapsed. %b then renders those escapes; %s would
	# print them verbatim.
	text=$(printf '%s' "$*" | tr '\n\t' '  ' | tr -s ' ')
	printf '%b\n' "$text" | fold -sw "$width" | pr -to "$space"
)

heading() {
	indent 2 "\033[1m$*\033[0m"
}

body() {
	while [ $# -gt 0 ]; do
		indent 6 "$1\n"
		shift
	done
}

option() {
	indent 6 $1
	shift
	while [ $# -gt 0 ]; do
		indent 10 "$1\n"
		shift
	done
}

# Returns the remote and/or branch set in the repository git config as a string.
# Exits 1 if not found (unless `-o` is set)
# getPrimary [-q] [-o] [-r] [-b]
getPrimary() (
	q=0 o=0 r=0 b=0
	OPTIND=1
	while getopts ":qorb" opt; do
		case $opt in
			q) q=1 ;; # print nothing; return only found or not found via return code
			o) o=1 ;; # error reporting off
			r) r=1 ;; # print remote
			b) b=1 ;; # print branch
			\?)
				echo >&2 "Unknown option -$OPTARG."
				return 1
				;;
		esac
	done

	if [ $r -eq 0 ] && [ $b -eq 0 ]; then r=1 b=1; fi
	if [ $q -eq 1 ]; then exec 1>/dev/null; fi
	remote=$(git config --local --get funcs.primaryRemote || :)
	branch=$(git config --local --get funcs.primaryBranch || :)
	# Local-only mode: combined r+b mode with no remote configured but a
	# branch set degrades to just the branch, never an error.
	if [ $r -eq 1 ] && [ $b -eq 1 ] && [ -z "$remote" ] && [ -n "$branch" ]; then
		echo "$branch"
		return 0
	fi
	if { [ -z "$remote" ] && [ $r -eq 1 ]; } || { [ -z "$branch" ] && [ $b -eq 1 ]; }; then
		if [ $o -eq 1 ]; then return 0; else return 1; fi
	fi;
	if [ $r -eq 1 ] && [ $b -eq 1 ]; then
		echo "${remote}/${branch}"
		if [ $o -eq 0 ]; then [ -n "$remote" ] && [ -n "$branch" ]; fi
	elif [ $r -eq 1 ]; then
		echo "$remote"
		if [ $o -eq 0 ]; then [ -n "$remote" ]; fi
	elif [ $b -eq 1 ]; then
		echo "$branch"
		if [ $o -eq 0 ]; then [ -n "$branch" ]; fi
	fi
)

# Returns the remote set in the repository git config as a string. Exits 1 if
# not found (unless `-o` is set). getPrimaryRemote is an alias for 'getPrimary
# -r'
# getPrimaryRemote [-o]
getPrimaryRemote() (
	getPrimary -r "$@"
)

# Returns the branch set in the repository git config as a string. Exits 1 if
# not found (unless `-o` is set). getPrimaryBranch is an alias for 'getPrimary
# -b'
# getPrimaryBranch [-o]
getPrimaryBranch() (
	getPrimary -b "$@"
)

# configValueOn returns whether a git config value is set to true
# configValueOn [-q|-e] [-o] <key> [<command>]
# configValueOn [-q|-e] [-o] -k <key> [-c <command>]
configValueOn() (
	q=1 echo=0 o=0
	OPTIND=1
	while getopts ":qeok:f:" opt; do
		case $opt in
			q) q=1; echo=0; ;;  # quiet on
			e) echo=1; q=0 ;;   # echo on
			o) o=1 ;;           # error reporting off
			k) key=$OPTARG; shift; ;;
			f) func=$OPTARG; shift; ;;
			:)
				echo >&2 "Option \`-$OPTARG\` requires an argument." \
					"Run git refresh -h for help."
				exit 1
				;;
			\?)
				echo >&2 "Unknown option -$OPTARG."
				return 1
				;;
		esac
	done
  shift $(expr $OPTIND - 1)

	key=${key:-$1}
	func=${func:-$2}
	if [ -z "$key" ]; then
		echo >&2 "configValueOn requires the name of the key"
		return 1
	fi

	[ -n "$func" ] && \
		val=$(git config --get --type=bool "funcs.$func.$key" || :)
	[ -z "$val" ] && \
		val=$(git config --get --type=bool "funcs.$key" || :)

	if [ $q -eq 1 ]; then
		[ "$val" = "true" ]
	else
		echo ${val:-"false"}
		if [ $o -eq 0 ]; then [ -z "$val" ]; fi
	fi
)

# Returns the configured stack parent of a branch (branch.<branch>.funcsBase),
# or nothing if unset. Exits 0 either way.
# getBranchBase <branch>
getBranchBase() (
	branch=$1
	git config --local --get "branch.$branch.funcsBase" 2>/dev/null || :
)

# Prints, one per line, the local branch names whose funcsBase is <branch>.
# Exits 0 whether or not any are found.
# getBranchChildren <branch>
getBranchChildren() (
	parent=$1
	# The `|| :` is load-bearing: under `set -e`, the pipeline's exit
	# status reflects the *last* config line's match (or "no matches at
	# all"), not a real failure, so it must not trip errexit.
	git config --local --get-regexp '^branch\..*\.funcsbase$' 2>/dev/null |
	while read -r key val; do
		name=${key#branch.}
		name=${name%.funcsbase}
		if [ "$val" = "$parent" ]; then echo "$name"; fi
	done || :
)

# Returns success iff simulating a merge of <branch> into <target> would be a
# no-op (i.e. <target> already contains all of <branch>'s changes), by
# comparing trees via `git merge-tree --write-tree`. This is the same
# squash/rebase-merge-aware check used by git-sweep and git-contains.
# Exit codes: 0 merged, 1 unmerged (tree differs), 2 merge-tree conflicted.
# isMergedInto <target> <branch>
isMergedInto() (
	target=$1
	branch=$2
	target_tree=$(git rev-parse "$target^{tree}" 2>/dev/null) || return 1
	merged_tree=$(git merge-tree --write-tree "$target" "$branch" 2>/dev/null) || return 2
	[ "$merged_tree" = "$target_tree" ] || return 1
	return 0
)

# Prints one "<headRefName>\t<headRefOid>" line per merged pull request on the
# repository's GitHub remote, newest first. Exits 1 when `gh` is missing,
# unauthenticated, or the remote isn't GitHub — callers treat that as "no PR
# data" and fall back to the tree comparison alone.
#
# One batched call rather than one per branch: a sweep over a repo with a
# hundred branches is a single request either way.
# loadMergedPrMap [<limit>]
loadMergedPrMap() (
	limit=${1:-1000}
	command -v gh >/dev/null 2>&1 || return 1
	gh pr list --state merged --limit "$limit" \
		--json headRefName,headRefOid \
		--jq '.[] | [.headRefName, .headRefOid] | @tsv' 2>/dev/null
)

# Returns success iff <branch> is fully contained in <oid>, the head commit of
# a merged pull request (as reported by loadMergedPrMap).
#
# This is the squash/rebase-merge escape hatch. isMergedInto compares trees,
# so it stops recognising a squash-merged branch the moment the target picks up
# any unrelated change — the branch then looks conflicted forever even though
# every line of it shipped. Asking what GitHub actually merged is the only
# reliable signal once history has been rewritten.
#
# The containment test is what keeps this safe: commits added to the branch
# *after* its PR merged leave it non-empty against <oid>, so it is kept. That
# also covers branch-name reuse — a recycled name carries new commits and fails
# the test.
# isMergedViaPR <oid> <branch>
isMergedViaPR() (
	oid=$1
	branch=$2
	[ -n "$oid" ] || return 1
	# The merged commit is usually absent locally: merging deletes the remote
	# branch and the next prune drops the objects. Fetch it before comparing.
	if ! git cat-file -e "$oid^{commit}" 2>/dev/null; then
		remote=$(getPrimaryRemote -o)
		git fetch --quiet "${remote:-origin}" "$oid" 2>/dev/null || return 1
	fi
	count=$(git rev-list --count "$oid..$branch" 2>/dev/null) || return 1
	[ "$count" = "0" ]
)

