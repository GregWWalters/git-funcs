#! /usr/bin/env sh

set -e # errexit
. "$(dirname "$0")/helpers"

# Help text
helpTxt() {
	heading 'NAME'
	body "git-resync - Rebase the local HEAD on the remote's latest HEAD"

	heading 'SYNOPSIS'
	body "git resync [-v|-q] [<remote>]"

	heading 'DESCRIPTION'
	body "Fetch the latest HEAD from this repository's remote and rebase the local
	HEAD on it. If <remote> is provided, it will show the primary branch for that
	remote instead of the primary remote."
	body "Otherwise, it will first check the repository's configuration for the
	primary remote, and if not found, return the first remote associated with the
	repository."
	body "To change the primary remote, use git-refresh -s <remote>."
	body "What a branch is maintained against is recorded by
	branch.<name>.funcsBase (see 'git new-branch -b'). Unset means the remote
	primary, which is the default. A local branch means the branch is stacked
	on it. Any other ref (tag, remote-tracking ref, sha) is a pinned base:
	resync rebases onto that ref instead of the primary. The literal value
	'none' means the branch has no base at all - resync reports it and leaves
	the branch alone, so 'git resync' stays safe to run unconditionally on
	every branch."
	body "If the current branch is part of a stack, resync restacks the whole
	stack: the root is rebased onto whatever it is maintained against, and
	every descendant is rebased onto its (possibly moved) parent, in order.
	A parent already merged into the stack's target (including via
	squash/rebase merge) is skipped over rather than replayed, and the child's
	funcsBase is re-pointed past it, inheriting the parent's own base. Use
	'git stack' to inspect the stack."

	heading 'OPTIONS'
	option '-q' '(quiet) Suppress writing to stdout. Overrides .gitconfig
		options funcs.verbose and funcs.resync.verbose.'
	option '-v' '(verbose) Print additional information'
	option '-h' 'Print this help'

	printf '\n'
}

case "$1" in
	"help"|"-help"|"--help")
		helpTxt
		exit 0
		;;
esac

q=0 v=0
while getopts ":hqv" opt; do
	case $opt in
		h) helpTxt; exit 0 ;;
		q) q=1; v=0 ;;
		v) v=1 ;;
		\?)
			echo >&2 "Unknown option -$OPTARG". \
				'Run git resync -h for help.'
			exit 1
			;;
	esac
done
shift $(expr $OPTIND - 1)

remoteArg=$1

if [ -z "$(git remote | head -n 1)" ]; then
	if [ -n "$remoteArg" ]; then
		echo >&2 "git-resync: remote '$remoteArg' does not exist (repository has no remotes)"
		exit 1
	fi
	echo >&2 "warning: no remote configured; nothing to sync"
	exit 0
fi

primary=${remoteArg:-$(git primary)}
if [ -z "$primary" ]; then
	echo >&2 "this repository has no remote set"
	exit 1
fi


remote=${primary%%/*}
branch=${primary#*/}

if [ $q -eq 1 ]; then v=0
elif [ $v -eq 1 ] || configValueOn -o -q "verbose" "resync"; then v=1
fi

current=$(git branch --show-current 2>/dev/null || :)
myBase=$(getBranchBase "$current" 2>/dev/null || :)
myChildren=""
[ -n "$current" ] && myChildren=$(getBranchChildren "$current" 2>/dev/null || :)

# redirect output of the next block
[ $v -eq 1 ] && exec 4>&1 || exec 4>/dev/null

if [ -z "$current" ] || { [ -z "$myBase" ] && [ -z "$myChildren" ]; }; then
	# Not part of a stack: exactly the historical behavior.
	{
		git fetch "$remote"
		git rebase --autostash -X patience "$remote/$branch"
	} >&4
	exit 0
fi

# --- Stack-aware restack cascade ---

# Path of the worktree where branch $1 is checked out, if any (empty
# otherwise). The two-arg 'git rebase <base> <branch>' form implicitly checks
# the branch out, which git refuses when it is already checked out in another
# worktree - so the cascade must rebase such branches in their own worktree.
branchWorktree() {
	git worktree list --porcelain | awk -v ref="refs/heads/$1" '
		/^worktree /{wt=substr($0,10)}
		$0=="branch "ref{print wt; exit}'
}

# Rebase branch $1 with the remaining args: in its own worktree when it is
# checked out somewhere, via the two-arg form otherwise. Leaves $rbWt set to
# the worktree used ("" for here) for cascadeFail's diagnosis.
rebaseBranch() {
	rbName=$1; shift
	rbWt=$(branchWorktree "$rbName")
	if [ -n "$rbWt" ]; then
		git -C "$rbWt" rebase "$@"
	else
		git rebase "$@" "$rbName"
	fi
}

# $1: branch that failed; $rbWt: worktree the rebase ran in (from
# rebaseBranch). Only claim a conflict when a rebase is actually in progress
# there - any other failure (e.g. a fatal before the rebase started) gets
# relayed as what it is.
cascadeFail() {
	cfDir=$(git ${rbWt:+-C "$rbWt"} rev-parse --git-dir 2>/dev/null || :)
	if [ -n "$cfDir" ] && { [ -d "$cfDir/rebase-merge" ] || [ -d "$cfDir/rebase-apply" ]; }; then
		echo >&2 "git-resync: rebase conflict while restacking '$1'${rbWt:+ (in worktree $rbWt)}."
		echo >&2 "Resolve the conflict (edit the files, 'git add' them), then run" \
			"'git rebase --continue' (or 'git rebase --abort' to cancel)${rbWt:+ there}. Re-run" \
			"'git resync' afterwards to finish restacking the rest of the stack."
	else
		echo >&2 "git-resync: rebasing '$1' failed before a rebase started;" \
			"see the git error above. Nothing is in progress to continue or abort."
	fi
	exit 1
}

# Find the stack root by walking funcsBase upward from $1. The walk stops at
# the first branch whose base is not another local branch: that branch is the
# root, and $rootKind/$rootBase record what the whole stack is maintained
# against (see resolveBase in helpers). Cycles are a hard error. Sets $root,
# $rootKind, $rootBase.
#
# A dangling base is handled by how it was written. A bare name is taken to be
# a stack parent that was deleted by hand: the stale link is unset (with a
# warning) and the branch becomes a primary-based root, as before. A qualified
# base (refs/... or <remote>/...) was a deliberate pin, so it is reported but
# never rewritten - silently falling back to the primary is the one thing a
# pin exists to prevent - and the branch is left unrebased.
findRoot() {
	b=$1
	seen=" $b "
	while :; do
		kv=$(resolveBase "$b")
		kind=${kv%% *}
		val=${kv#* }
		case "$kind" in
			primary|none|ref)
				root=$b; rootKind=$kind; rootBase=$val
				return 0
				;;
			dangling)
				if baseIsQualified "$val"; then
					echo >&2 "warning: branch '$b' has funcsBase '$val', which does" \
						"not resolve; leaving the pin recorded and not rebasing '$b'." \
						"Fix or unset it with 'git config --local branch.$b.funcsBase'."
					root=$b; rootKind=none; rootBase=$val
					return 0
				fi
				echo >&2 "warning: branch '$b' has funcsBase '$val', which no longer" \
					"exists; treating '$b' as the stack root and clearing the stale link"
				git config --local --unset "branch.$b.funcsBase"
				root=$b; rootKind=primary; rootBase="-"
				return 0
				;;
		esac
		p=$val
		case "$seen" in
			*" $p "*)
				echo >&2 "git-resync: cycle detected in funcsBase chain" \
					"($seen$p ...); refusing to guess. Fix branch.<name>.funcsBase" \
					"manually with 'git config --local --unset'."
				exit 1
				;;
		esac
		seen="$seen$p "
		b=$p
	done
}

# Prints "<branch> <parent>" pairs in BFS order rooted at $1 (root's parent
# printed as "-"). Guards against config-graph cycles below the root too.
buildStack() {
	r=$1
	printf '%s -\n' "$r"
	queue=$r
	visited=" $r "
	while [ -n "$queue" ]; do
		node=${queue%% *}
		if [ "$node" = "$queue" ]; then queue=""; else queue=${queue#* }; fi
		children=$(getBranchChildren "$node" 2>/dev/null || :)
		for c in $children; do
			case "$visited" in
				*" $c "*) continue ;;
			esac
			visited="$visited$c "
			printf '%s %s\n' "$c" "$node"
			queue="$queue $c"
		done
	done
}

findRoot "$current"

# What the stack is ultimately maintained against. Empty means nothing: the
# root is pinned, so it is never rebased and "has this landed?" has no answer
# to check against.
case "$rootKind" in
	primary) targetRef="$remote/$branch" ;;
	ref)     targetRef="$rootBase" ;;
	*)       targetRef="" ;;
esac

stackfile=$(mktemp)
oldshafile=$(mktemp)
datafile=$(mktemp)
trap 'rm -f "$stackfile" "$oldshafile" "$datafile"' EXIT

buildStack "$root" > "$stackfile"

# A lone pinned branch has nothing to sync against and no descendants to
# restack: say so and stop, without even fetching.
if [ -z "$targetRef" ] && [ "$(awk 'END{print NR}' "$stackfile")" -eq 1 ]; then
	if [ "$rootBase" = "-" ]; then
		echo >&2 "notice: '$root' has no base (funcsBase = none); not rebasing."
	fi
	exit 0
fi

{
	git fetch "$remote"
	if [ "$rootKind" = "ref" ]; then
		pinRemote=$(baseRemote "$rootBase")
		if [ -n "$pinRemote" ] && [ "$pinRemote" != "$remote" ]; then
			git fetch "$pinRemote"
		fi
	fi
} >&4

if [ -z "$targetRef" ] && [ "$rootBase" = "-" ]; then
	echo >&2 "notice: '$root' has no base (funcsBase = none); not rebasing it," \
		"but restacking its descendants onto it."
fi

: > "$oldshafile"
: > "$datafile"
while read -r name parent; do
	sha=$(git rev-parse "refs/heads/$name")
	merged=0
	psha=""
	if [ "$parent" != "-" ]; then
		psha=$(awk -F'\t' -v n="$parent" '$1==n{print $2; exit}' "$oldshafile")
		if [ -n "$targetRef" ] && isMergedInto "$targetRef" "$psha"; then merged=1; fi
	fi
	printf '%s\t%s\n' "$name" "$sha" >> "$oldshafile"
	printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$parent" "$sha" "$merged" "$psha" >> "$datafile"
done < "$stackfile"

{
	while IFS='	' read -r name parent oldsha merged psha; do
		if [ "$parent" = "-" ]; then
			if [ -z "$targetRef" ]; then
				if [ $v -eq 1 ]; then echo "$name has no base; not rebasing it"; fi
				continue
			fi
			rebaseBranch "$name" --autostash -X patience "$targetRef" \
				|| cascadeFail "$name"
			if [ $v -eq 1 ]; then echo "restacked $name onto $targetRef"; fi
			continue
		fi

		if git merge-base --is-ancestor "refs/heads/$parent" "refs/heads/$name" 2>/dev/null; then
			if [ $v -eq 1 ]; then echo "$name already based on $parent; skipping"; fi
			continue
		fi

		if [ "$merged" = "1" ]; then
			gp=$(awk -F'\t' -v n="$parent" '$1==n{print $2; exit}' "$datafile")
			if [ "$gp" = "-" ]; then
				# Skipping past the root: the child inherits the root's own
				# base verbatim, so a pinned stack stays pinned.
				newbase="$targetRef"
				if [ "$rootKind" = "ref" ]; then newcfg="$rootBase"; else newcfg=""; fi
			else
				newbase="refs/heads/$gp"
				newcfg="$gp"
			fi
			rebaseBranch "$name" --autostash -X patience --onto "$newbase" "$psha" \
				|| cascadeFail "$name"
			if [ -n "$newcfg" ]; then
				git config --local "branch.$name.funcsBase" "$newcfg"
			else
				git config --local --unset "branch.$name.funcsBase"
			fi
			if [ $v -eq 1 ]; then echo "restacked $name past merged '$parent' onto $newbase"; fi
		else
			rebaseBranch "$name" --autostash -X patience --onto "refs/heads/$parent" "$psha" \
				|| cascadeFail "$name"
			if [ $v -eq 1 ]; then echo "restacked $name onto $parent"; fi
		fi
	done < "$datafile"

	git checkout "$current"
} >&4
