#! /usr/bin/env sh

set -e # errexit
. "$(dirname "$0")/helpers"

helpTxt() {
	heading 'NAME'
	body 'git-new-tree - Create a worktree, attaching or creating its branch'

	heading 'SYNOPSIS'
	body 'git new-tree [-q|-v] [-P] [-d <base-dir>] [-p <path>] <branch>'

	heading 'DESCRIPTION'
	body "Create a worktree for <branch>. If <branch> already exists locally,
attach the worktree to it. Otherwise, create <branch> from the refreshed
primary remote's HEAD (as 'git new-branch' does). To base on a non-primary
remote, first set it with 'git refresh -s <remote>'."

	body "By default, the worktree is placed at <base>/<branch>, where <base>
is the first of: the path given to -p (used verbatim; -d ignored), the
-d <base-dir> argument, the local git config value funcs.worktree.dir, or
'<repo-parent>/wtree/<repo-name>'. Relative bases are anchored at the main
worktree root. Missing parent directories are created and rolled back on
failure."

	body "Branch names containing '/' (such as 'feature/PROJ-123_title') segment
naturally into subdirectories under <base>."

	body "After creating the worktree, entries listed in the committed file
.worktree-populate at the repo root (if present) and in the local git
config keys funcs.worktree.copyPath and funcs.worktree.linkPath
(multi-value) are populated into the new worktree from the main worktree
at the same relative path. 'copy' entries are copied recursively; 'link'
entries become absolute symlinks pointing back at the source. Useful for
gitignored files that new worktrees need in place (e.g. .env). Existing
destinations are never overwritten."

	body "The behavior when a source is missing is configurable. The local
git config key funcs.worktree.onMissing sets it for config-sourced
entries (default 'warn'; values: 'warn' | 'silent' | 'block'). A
'!onMissing <value>' directive line in .worktree-populate sets it for
manifest-sourced entries, overriding the config default for those. 'warn'
prints to stderr and skips; 'silent' skips quietly; 'block' prints to
stderr, tears down the new worktree, and exits non-zero. See CONFIG.md
for the .worktree-populate file format."

	body "On success, the absolute path of the new worktree is printed to
stdout, so it can be captured in a shell wrapper to cd into."

	heading 'OPTIONS'
	option '-d <base-dir>' '(dir) Override the worktree base directory for this
run. Ignored when -p is set.'
	option '-p <path>' '(path) Use <path> verbatim as the worktree path; skip
base-dir composition.'
	option '-P' '(no-populate) Skip populating configured funcs.worktree.copyPath
and funcs.worktree.linkPath entries into the new worktree.'
	option '-q' '(quiet) Suppress writing to stdout. Overrides .gitconfig
options funcs.verbose and funcs.new-tree.verbose.'
	option '-v' '(verbose) Print additional information'
	option '-h' '(help) Print this help'

	echo "\n"
}

case "$1" in
	"help"|"-help"|"--help")
		helpTxt
		exit 0
		;;
esac

q=0 v=0 dirArg="" pathArg="" populate=1
while getopts ":hqvPd:p:" opt; do
	case $opt in
		h) helpTxt; exit 0 ;;
		q) q=1 v=0 ;;
		v) v=1 ;;
		P) populate=0 ;;
		d) dirArg=$OPTARG ;;
		p) pathArg=$OPTARG ;;
		:)
			echo >&2 "Option \`-$OPTARG\` requires an argument." \
				"Run git new-tree -h for help."
			exit 1
			;;
		\?)
			echo >&2 "Unknown option -$OPTARG. Run git new-tree -h for help."
			exit 1
			;;
	esac
done
shift $(expr $OPTIND - 1)

if [ $q -eq 1 ]; then
	v=0
elif [ $v -eq 1 ] || configValueOn -o -q "verbose" "new-tree"; then
	v=1
fi

branch=$1
if [ -z "$branch" ]; then
	echo >&2 "git new-tree requires 1 argument <branch name>"
	exit 1
fi

# Resolve worktree path. Always derive from the main worktree so behavior is
# identical whether invoked from the main checkout or a linked worktree.
toplevel=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
if [ -n "$pathArg" ]; then
	wtPath=$pathArg
else
	if [ -n "$dirArg" ]; then
		base=$dirArg
	else
		base=$(git config --local --get funcs.worktree.dir || :)
		if [ -z "$base" ]; then
			base="$(dirname "$toplevel")/wtree/$(basename "$toplevel")"
		fi
	fi
	case "$base" in
		/*) ;;
		*) base="$toplevel/$base" ;;
	esac
	wtPath="$base/$branch"
fi

# redirect informational output of the next block
[ $v -eq 1 ] && exec 4>&1 || exec 4>/dev/null
{
	echo "worktree path: $wtPath"

	parentDir=$(dirname "$wtPath")
	createdParent=""
	if [ ! -d "$parentDir" ]; then
		echo "creating parent directory: $parentDir"
		mkdir -p "$parentDir"
		createdParent=$parentDir
	fi

	rollback() {
		if [ -n "$createdParent" ]; then
			rmdir -p "$createdParent" 2>/dev/null || :
		fi
	}

	if git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
		echo "branch $branch exists; attaching worktree"
		branchExisted=1
		git worktree add "$wtPath" "$branch" || { rollback; exit 1; }
	else
		echo "branch $branch does not exist; creating from refreshed primary"
		branchExisted=0
		git refresh -q
		base_ref=$(getPrimary)
		if [ -z "$base_ref" ]; then
			echo >&2 "failed to resolve primary ref"
			rollback
			exit 1
		fi
		echo "basing $branch on $base_ref"
		git worktree add --no-track -b "$branch" "$wtPath" "$base_ref" || { rollback; exit 1; }
	fi
} >&4

# Populate configured files/dirs from the main worktree into the new one.
# funcs.worktree.copyPath: recursive copy, preserves file type (dirs -> dirs).
# funcs.worktree.linkPath: absolute symlink pointing back at the source.
# Existing destinations are never overwritten. Missing-source behavior is
# per-entry, resolved from funcs.worktree.onMissing (config entries) or
# a '!onMissing' directive in .worktree-populate (manifest entries):
#   warn   - stderr + skip (default)
#   silent - skip quietly
#   block  - stderr + tear down the worktree + exit non-zero
# Warnings go to stderr regardless of -q so misconfiguration is visible;
# per-item success messages only appear under -v (via fd 4 already opened).
if [ $populate -eq 1 ]; then
	# Resolve config default for onMissing; validate.
	cfgOnMissing=$(git config --local --get funcs.worktree.onMissing 2>/dev/null || echo warn)
	case "$cfgOnMissing" in
		warn|silent|block) ;;
		*)
			echo >&2 "worktree populate: invalid funcs.worktree.onMissing '$cfgOnMissing'; using 'warn'"
			cfgOnMissing=warn
			;;
	esac

	# populateOne returns:
	#   0 - populated or skipped (warn/silent, or benign guard hit)
	#   2 - missing source with onMissing=block; caller must tear down
	populateOne() (
		mode=$1 om=$2 rel=$3 srcRoot=$4 dstRoot=$5
		# Strip a leading './' for user convenience, then reject anything
		# that would escape the worktree or reach outside it.
		rel=${rel#./}
		case "/$rel/" in
			*/../*|*//*)
				echo >&2 "worktree $mode: '$rel' contains '..' or empty segment; skipping"
				return 0
				;;
		esac
		case "$rel" in
			/*)
				echo >&2 "worktree $mode: '$rel' is an absolute path; skipping"
				return 0
				;;
			"")
				return 0
				;;
		esac
		src=$srcRoot/$rel
		dst=$dstRoot/$rel
		if [ ! -e "$src" ] && [ ! -L "$src" ]; then
			case $om in
				silent) return 0 ;;
				block)
					echo >&2 "worktree $mode: source '$rel' does not exist in $srcRoot; onMissing=block, aborting"
					return 2
					;;
				*)
					echo >&2 "worktree $mode: source '$rel' does not exist in $srcRoot; skipping"
					return 0
					;;
			esac
		fi
		if [ -e "$dst" ] || [ -L "$dst" ]; then
			echo >&2 "worktree $mode: destination '$rel' already exists in worktree; skipping"
			return 0
		fi
		parent=$(dirname "$dst")
		if [ ! -d "$parent" ] && ! mkdir -p "$parent" 2>/dev/null; then
			echo >&2 "worktree $mode: could not create parent dir for '$rel'; skipping"
			return 0
		fi
		case $mode in
			copy)
				if cp -R "$src" "$dst" 2>/dev/null; then
					echo "worktree copy: $rel"
				else
					echo >&2 "worktree copy: failed to copy '$rel'"
				fi
				;;
			link)
				if ln -s "$src" "$dst" 2>/dev/null; then
					echo "worktree link: $rel -> $src"
				else
					echo >&2 "worktree link: failed to link '$rel'"
				fi
				;;
		esac
	)

	# Two-pass over the manifest so a '!onMissing' directive anywhere in
	# the file applies to every manifest entry (last-set wins with a
	# warning). Config-sourced entries always use cfgOnMissing.
	manifest=$toplevel/.worktree-populate
	manifestOnMissing=""
	streamFile=$(mktemp) || { echo >&2 "worktree populate: mktemp failed"; exit 1; }
	# shellcheck disable=SC2064
	trap "rm -f '$streamFile'" EXIT INT HUP TERM

	# Pass 1: scan manifest for the onMissing directive only.
	if [ -f "$manifest" ]; then
		lineno=0
		while IFS= read -r line || [ -n "$line" ]; do
			lineno=$((lineno + 1))
			line=${line%%#*}
			line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
			[ -z "$line" ] && continue
			tok=${line%%[[:space:]]*}
			[ "$tok" = "!onMissing" ] || continue
			val=${line#"$tok"}
			val=$(printf '%s' "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
			case "$val" in
				warn|silent|block)
					if [ -n "$manifestOnMissing" ] && [ "$manifestOnMissing" != "$val" ]; then
						echo >&2 "worktree populate: .worktree-populate:$lineno '!onMissing' already set to '$manifestOnMissing'; overriding with '$val'"
					fi
					manifestOnMissing=$val
					;;
				*)
					echo >&2 "worktree populate: .worktree-populate:$lineno '!onMissing' value must be warn|silent|block; got '$val'; ignoring"
					;;
			esac
		done < "$manifest"
	fi
	resolvedManifestOM=${manifestOnMissing:-$cfgOnMissing}

	# Pass 2: emit a normalized stream of "<mode> <onMissing> <rel>" lines.
	# Sources are unioned; duplicate destinations hit the existing
	# already-exists guard in populateOne, so precedence is "whichever ran
	# first wins" with a warning for the loser.
	{
		if [ -f "$manifest" ]; then
			lineno=0
			while IFS= read -r line || [ -n "$line" ]; do
				lineno=$((lineno + 1))
				line=${line%%#*}
				line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
				[ -z "$line" ] && continue
				mode=${line%%[[:space:]]*}
				rel=${line#"$mode"}
				rel=$(printf '%s' "$rel" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
				case "$mode" in
					!onMissing) ;; # already handled in pass 1
					copy|link)
						if [ -z "$rel" ]; then
							echo >&2 "worktree populate: .worktree-populate:$lineno '$mode' with no path; skipping"
						else
							printf '%s %s %s\n' "$mode" "$resolvedManifestOM" "$rel"
						fi
						;;
					*)
						echo >&2 "worktree populate: .worktree-populate:$lineno unknown directive '$mode'; skipping"
						;;
				esac
			done < "$manifest"
		fi
		git config --local --get-all funcs.worktree.copyPath 2>/dev/null |
			while IFS= read -r rel; do
				[ -n "$rel" ] && printf 'copy %s %s\n' "$cfgOnMissing" "$rel"
			done
		git config --local --get-all funcs.worktree.linkPath 2>/dev/null |
			while IFS= read -r rel; do
				[ -n "$rel" ] && printf 'link %s %s\n' "$cfgOnMissing" "$rel"
			done
	} > "$streamFile"

	# Consume the stream in the current shell so we can react to a block.
	blockFail=0
	while IFS= read -r entry; do
		[ -z "$entry" ] && continue
		mode=${entry%% *}
		rest=${entry#* }
		om=${rest%% *}
		rel=${rest#* }
		if [ -z "$mode" ] || [ -z "$rel" ]; then continue; fi
		populateOne "$mode" "$om" "$rel" "$toplevel" "$wtPath" >&4 && rc=0 || rc=$?
		if [ $rc -eq 2 ]; then
			blockFail=1
			break
		fi
	done < "$streamFile"

	if [ $blockFail -eq 1 ]; then
		echo >&2 "worktree populate: tearing down $wtPath"
		git worktree remove --force "$wtPath" 2>/dev/null || :
		[ "$branchExisted" = "0" ] && git branch -D "$branch" 2>/dev/null || :
		[ -n "$createdParent" ] && rmdir -p "$createdParent" 2>/dev/null || :
		exit 1
	fi
fi

# Always print the absolute worktree path on stdout for shell wrappers
if [ $q -eq 0 ]; then
	( cd "$wtPath" && pwd ) 2>/dev/null || echo "$wtPath"
fi
