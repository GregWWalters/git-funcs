#! /usr/bin/env sh

set -e # errexit
. "$(dirname "$0")/helpers"

# Help text
helpTxt() {
	heading 'NAME'
	body 'git-pin - Record what the current branch is maintained against'

	heading 'SYNOPSIS'
	body 'git pin [-q|-v] [-u] [<base>]'

	heading 'DESCRIPTION'
	body 'Set branch.<current-branch>.funcsBase: the base "git resync" rebases
	this branch onto, and the one "git stack" and "git sweep" consult.'
	body 'With no argument, pins the branch with no base at all. "git resync"
	then reports it and never rebases it, and "git sweep" never deletes it.
	Use this for a branch that must not pick up the primary - a long-lived
	release branch, a vendored fork, anything deliberately frozen.'
	body 'With <base>, pins to that ref instead: a tag, a remote-tracking ref
	such as origin/release/2.4, or a sha. "git resync" rebases onto it,
	fetching its remote first, and never brings in the primary. A local
	branch is recorded as a stack parent instead, the same relationship
	"git new-branch -b" creates.'
	body 'With -u, unpins: the recorded base is removed and the branch follows
	the primary again.'
	body 'Pinning is recorded once, in this repository'\''s local config, so it
	holds for every later "git resync" without anyone having to remember it.
	That is the point: "git resync" stays safe to run on every branch, so
	whether to run it never becomes a per-push judgment call. Run "git stack"
	to see what the current branch is based on.'

	heading 'OPTIONS'
	option '-u' '(unpin) Remove the recorded base; the branch follows the
		primary again.'
	option '-q' '(quiet) Suppress writing to stdout. Overrides .gitconfig
		options funcs.verbose and funcs.pin.verbose.'
	option '-v' '(verbose) Print additional information'
	option '-h' '(help) Print this help'

	echo "\n"
}

case "$1" in
	"help"|"-help"|"--help")
		helpTxt
		exit 0
		;;
esac

q=0 v=0 unpin=0
while getopts ":hquv" opt; do
	case $opt in
		h) helpTxt; exit 0 ;;
		q) q=1; v=0 ;;
		u) unpin=1 ;;
		v) v=1 ;;
		\?)
			echo >&2 "Unknown option -$OPTARG. Run git pin -h for help."
			exit 1
			;;
	esac
done
shift $(expr $OPTIND - 1)

if [ $q -eq 1 ]; then v=0
elif [ $v -eq 1 ] || configValueOn -o -q "verbose" "pin"; then v=1
fi

baseArg=$1

if [ $unpin -eq 1 ] && [ -n "$baseArg" ]; then
	echo >&2 "git-pin: -u takes no <base> argument."
	exit 1
fi

current=$(git branch --show-current 2>/dev/null || :)
if [ -z "$current" ]; then
	echo >&2 "git-pin: not on a branch (detached HEAD)."
	exit 1
fi

primaryBranch=$(getPrimaryBranch -o)
if [ -n "$primaryBranch" ] && [ "$current" = "$primaryBranch" ]; then
	echo >&2 "git-pin: '$current' is this repository's primary branch; it has no" \
		"base to pin. Pin a working branch instead."
	exit 1
fi

report() {
	[ $q -eq 0 ] || return 0
	echo "$1"
	if [ $v -eq 1 ]; then
		echo "  branch.$current.funcsBase = $(getBranchBase "$current" || echo '<unset>')"
	fi
	return 0
}

# --- unpin ---------------------------------------------------------------

if [ $unpin -eq 1 ]; then
	old=$(getBranchBase "$current")
	if [ -z "$old" ]; then
		report "$current is not pinned; nothing to do."
		exit 0
	fi
	git config --local --unset "branch.$current.funcsBase"
	report "unpinned $current (was '$old'); it follows $(git primary) again."
	exit 0
fi

# --- pin with no base ----------------------------------------------------

pinNone() {
	git config --local "branch.$current.funcsBase" none
	report "pinned $current with no base; 'git resync' will not rebase it."
	exit 0
}

[ -z "$baseArg" ] && pinNone
case "$(printf '%s' "$baseArg" | tr '[:upper:]' '[:lower:]')" in
	none) pinNone ;;
esac

# --- pin to a base -------------------------------------------------------

case "$baseArg" in
	"."|"@") base=$current ;;
	*)       base=$baseArg ;;
esac

if [ "$base" = "$current" ] || [ "$base" = "refs/heads/$current" ]; then
	echo >&2 "git-pin: a branch cannot be its own base."
	exit 1
fi

if ! git rev-parse --verify --quiet "refs/heads/$base" >/dev/null 2>&1 \
	&& ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1; then
	echo >&2 "git-pin: base '$base' does not resolve to a branch or ref."
	exit 1
fi

# A base that is a local branch is a stack parent, so it must not lead back
# here: git-resync refuses to guess on a cycle, and it is cheaper to catch
# that now than to leave the stack unresyncable.
if git rev-parse --verify --quiet "refs/heads/$base" >/dev/null 2>&1; then
	walk=$base
	seen=" $base "
	while :; do
		next=$(getBranchBase "$walk")
		[ -n "$next" ] || break
		if [ "$next" = "$current" ] || [ "$next" = "refs/heads/$current" ]; then
			echo >&2 "git-pin: '$base' is already stacked on '$current', directly" \
				"or through its parents; pinning it here would make a cycle."
			exit 1
		fi
		case "$seen" in
			*" $next "*) break ;;
		esac
		seen="$seen$next "
		git rev-parse --verify --quiet "refs/heads/$next" >/dev/null 2>&1 || break
		walk=$next
	done
fi

git config --local "branch.$current.funcsBase" "$base"

kv=$(resolveBase "$current")
case "${kv%% *}" in
	branch)
		report "stacked $current on $base; 'git resync' restacks the whole stack."
		;;
	*)
		report "pinned $current to $base; 'git resync' rebases onto it, not the primary."
		;;
esac
exit 0
