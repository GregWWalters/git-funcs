#! /usr/bin/env sh

set -e # errexit
. "$(dirname "$0")/helpers"

helpTxt() {
	heading 'NAME'
	body 'git-stack - Show the current branch'\''s stack of dependent branches'

	heading 'SYNOPSIS'
	body 'git stack [-q|-v] [-h]'

	heading 'DESCRIPTION'
	body 'Print the tree of branches the current branch is stacked with, as
	recorded by branch.<name>.funcsBase (set by "git new-branch -b"). Root
	first, one branch per line, indented two spaces per depth beneath the
	base line.'
	body 'The first line is what the stack is maintained against: the remote
	primary by default, or the pinned ref recorded in the root'\''s funcsBase,
	or "(no base)" when the root is pinned with funcsBase = none and is never
	rebased.'
	body 'If the current branch is not part of a stack, prints
	"<branch> (not stacked; base: <remote>/<primary>)" instead - or the
	branch'\''s pinned base in place of the primary.'
	body 'Markers: " *" the current branch; " [merged]" the branch is fully
	contained in the stack'\''s target (including via squash/rebase merge);
	" [base missing]" the branch'\''s recorded base no longer resolves (a bare
	parent name is repaired automatically the next time "git resync" runs on
	this stack; a pinned ref is left for you to fix).'
	body 'This command never modifies anything, including a dangling
	funcsBase link (unlike "git resync", which repairs it).'

	heading 'OPTIONS'
	option '-q' '(quiet) Suppress writing to stdout. Overrides .gitconfig
		options funcs.verbose and funcs.stack.verbose.'
	option '-v' '(verbose) Print additional information'
	option '-h' '(help) Print this help'
}

case "$1" in
	"help"|"-help"|"--help")
		helpTxt
		exit 0
		;;
esac

q=0 v=0
while getopts ":hqv" opt; do
	case $opt in
		h) helpTxt; exit 0 ;;
		q) q=1; v=0 ;;
		v) v=1 ;;
		\?)
			echo >&2 "Unknown option -$OPTARG. Run git stack -h for help."
			exit 1
			;;
	esac
done
shift $(expr $OPTIND - 1)

if [ $q -eq 1 ]; then v=0
elif [ $v -eq 1 ] || configValueOn -o -q "verbose" "stack"; then v=1
fi

current=$(git branch --show-current 2>/dev/null || :)
if [ -z "$current" ]; then
	echo >&2 "git-stack: not on a branch (detached HEAD)."
	exit 1
fi

primary=$(git primary)

myKv=$(resolveBase "$current")
myKind=${myKv%% *}
myVal=${myKv#* }
myChildren=$(getBranchChildren "$current" 2>/dev/null || :)

if [ -z "$myChildren" ]; then
	case "$myKind" in
		primary)
			[ $q -eq 0 ] && echo "$current (not stacked; base: $primary)"
			exit 0
			;;
		none)
			[ $q -eq 0 ] && echo "$current (pinned; no base)"
			exit 0
			;;
		ref)
			[ $q -eq 0 ] && echo "$current (not stacked; pinned base: $myVal)"
			exit 0
			;;
	esac
fi

# Find the stack root by walking funcsBase upward from $1, read-only: the walk
# stops at the first branch whose base is not another local branch, recording
# what the stack is maintained against in $rootKind/$rootBase. Warns (but does
# not repair) a dangling base, and errors on a cycle. Sets $root, $rootKind,
# $rootBase, $rootDangling (0/1), $rootMissingBase.
findRoot() {
	b=$1
	seen=" $b "
	rootDangling=0
	rootMissingBase=""
	while :; do
		kv=$(resolveBase "$b")
		kind=${kv%% *}
		p=${kv#* }
		case "$kind" in
			primary|none|ref)
				root=$b; rootKind=$kind; rootBase=$p
				return 0
				;;
			dangling)
				echo >&2 "warning: branch '$b' has funcsBase '$p', which no longer exists"
				root=$b
				rootKind=none
				rootBase=$p
				rootDangling=1
				rootMissingBase=$p
				return 0
				;;
		esac
		case "$seen" in
			*" $p "*)
				echo >&2 "git-stack: cycle detected in funcsBase chain" \
					"($seen$p ...); refusing to guess."
				exit 1
				;;
		esac
		seen="$seen$p "
		b=$p
	done
}

findRoot "$current"

# What the stack is maintained against, and the ref [merged] is checked
# against. Empty means the root is pinned to nothing, so neither applies.
case "$rootKind" in
	primary) targetRef=$primary ;;
	ref)     targetRef=$rootBase ;;
	*)       targetRef="" ;;
esac

printSeen=" $root "

printNode() {
	name=$1
	depth=$2
	sha=$(git rev-parse --short "refs/heads/$name")
	marker=""
	[ "$name" = "$current" ] && marker="$marker *"
	if [ -n "$targetRef" ] && isMergedInto "$targetRef" "refs/heads/$name"; then
		marker="$marker [merged]"
	fi
	if [ "$name" = "$root" ] && [ "$rootDangling" -eq 1 ]; then
		marker="$marker [base missing]"
	fi
	indent=""
	i=0
	while [ "$i" -lt "$depth" ]; do
		indent="$indent  "
		i=$((i + 1))
	done
	printf '%s%s %s%s\n' "$indent" "$name" "$sha" "$marker"
	children=$(getBranchChildren "$name" 2>/dev/null | sort || :)
	for c in $children; do
		case "$printSeen" in
			*" $c "*) continue ;;
		esac
		printSeen="$printSeen$c "
		printNode "$c" $((depth + 1))
	done
}

[ $q -eq 1 ] && exit 0

if [ -n "$targetRef" ]; then
	echo "$targetRef"
elif [ "$rootDangling" -eq 1 ]; then
	echo "$rootMissingBase (unresolved)"
else
	echo "(no base)"
fi
printNode "$root" 1
