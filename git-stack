#! /usr/bin/env sh

set -e # errexit
. "$(dirname "$0")/helpers"

helpTxt() {
	heading 'NAME'
	body 'git-stack - Show, or set, what the current branch is stacked on'

	heading 'SYNOPSIS'
	body 'git stack [-q|-v] [-h]'
	body 'git stack [-q|-v] <base>'
	body 'git stack [-q|-v] -n'
	body 'git stack [-q|-v] -u'

	heading 'DESCRIPTION'
	body 'The one command for stacked diffs: read the stack with no argument,
	write it with one. Both halves work on branch.<name>.funcsBase, the
	record of what a branch is maintained against - the base "git resync"
	rebases onto, and the one "git sweep" consults.'

	heading 'SHOWING THE STACK'
	body 'With no argument, print the tree of branches the current branch is
	stacked with, as recorded by branch.<name>.funcsBase (set by this
	command or by "git new-branch -b"). Root first, one branch per line,
	indented two spaces per depth beneath the base line.'
	body 'The first line is what the stack is maintained against: the remote
	primary by default, or the pinned ref recorded in the root'\''s funcsBase,
	or "(no base)" when the root is pinned with funcsBase = none and is never
	rebased.'
	body 'If the current branch is not part of a stack, prints
	"<branch> (not stacked; base: <remote>/<primary>)" instead - or the
	branch'\''s pinned base in place of the primary.'
	body 'Markers: " *" the current branch; " [merged]" the branch is fully
	contained in the stack'\''s target (including via squash/rebase merge);
	" [base missing]" the branch'\''s recorded base no longer resolves (a bare
	parent name is repaired automatically the next time "git resync" runs on
	this stack; a pinned ref is left for you to fix).'
	body 'Showing never modifies anything, including a dangling funcsBase link
	(unlike "git resync", which repairs it).'

	heading 'SETTING THE BASE'
	body 'With <base>, record it as the current branch'\''s base. A local branch
	is recorded as a stack parent - the stacked-diff relationship, the same
	one "git new-branch -b" creates, so "git resync" restacks the whole
	stack. Any other commit-ish (a tag, a remote-tracking ref such as
	origin/release/2.4, or a sha) is recorded as a pinned base: "git resync"
	rebases onto it, fetching its remote first, and never brings in the
	primary.'
	body 'With -n, records no base at all. "git resync" then reports the branch
	and never rebases it, and "git sweep" never deletes it. Use this for a
	branch that must not pick up the primary - a long-lived release branch,
	a vendored fork, anything deliberately frozen.'
	body 'With -u, unstacks: the recorded base is removed and the branch
	follows the primary again.'
	body 'The base is recorded once, in this repository'\''s local config, so it
	holds for every later "git resync" without anyone having to remember it.
	That is the point: "git resync" stays safe to run on every branch, so
	whether to run it never becomes a per-push judgment call.'

	heading 'OPTIONS'
	option '-n' '(none) Record no base; "git resync" never rebases the branch.'
	option '-u' '(unstack) Remove the recorded base; the branch follows the
		primary again.'
	option '-q' '(quiet) Suppress writing to stdout. Overrides .gitconfig
		options funcs.verbose and funcs.stack.verbose.'
	option '-v' '(verbose) Print additional information'
	option '-h' '(help) Print this help'

	heading 'EXAMPLES'
	body 'git stack                     # show the tree and what it is based on
	git stack feature/api         # stack the current branch on feature/api
	git stack origin/release/2.4  # pin it to a release line, not trunk
	git stack -n                  # no base: never rebase this branch
	git stack -u                  # unstack: follow the primary again'
}

case "$1" in
	"help"|"-help"|"--help")
		helpTxt
		exit 0
		;;
esac

q=0 v=0 unstack=0 setNone=0
while getopts ":hnquv" opt; do
	case $opt in
		h) helpTxt; exit 0 ;;
		n) setNone=1 ;;
		q) q=1; v=0 ;;
		u) unstack=1 ;;
		v) v=1 ;;
		\?)
			echo >&2 "Unknown option -$OPTARG. Run git stack -h for help."
			exit 1
			;;
	esac
done
shift $(expr $OPTIND - 1)

if [ $q -eq 1 ]; then v=0
elif [ $v -eq 1 ] || configValueOn -o -q "verbose" "stack"; then v=1
fi

baseArg=$1

if [ $unstack -eq 1 ] && [ $setNone -eq 1 ]; then
	echo >&2 "git-stack: -u and -n are mutually exclusive."
	exit 1
fi
if [ -n "$baseArg" ] && { [ $unstack -eq 1 ] || [ $setNone -eq 1 ]; }; then
	echo >&2 "git-stack: -u and -n take no <base> argument."
	exit 1
fi

current=$(git branch --show-current 2>/dev/null || :)
if [ -z "$current" ]; then
	echo >&2 "git-stack: not on a branch (detached HEAD)."
	exit 1
fi

# Reading and writing are one command, so which mode we are in is decided by
# the arguments alone: any of -u, -n or a <base> writes, nothing reads.
if [ $unstack -eq 0 ] && [ $setNone -eq 0 ] && [ -z "$baseArg" ]; then
	writing=0
else
	writing=1
fi

primary=$(git primary)

# ==== set the base =======================================================

if [ $writing -eq 1 ]; then

	primaryBranch=$(getPrimaryBranch -o)
	if [ -n "$primaryBranch" ] && [ "$current" = "$primaryBranch" ]; then
		echo >&2 "git-stack: '$current' is this repository's primary branch; it has" \
			"no base to record. Stack a working branch instead."
		exit 1
	fi

	report() {
		[ $q -eq 0 ] || return 0
		echo "$1"
		if [ $v -eq 1 ]; then
			echo "  branch.$current.funcsBase = $(getBranchBase "$current" || echo '<unset>')"
		fi
		return 0
	}

	# --- unstack -------------------------------------------------------------

	if [ $unstack -eq 1 ]; then
		old=$(getBranchBase "$current")
		if [ -z "$old" ]; then
			report "$current has no recorded base; nothing to do."
			exit 0
		fi
		git config --local --unset "branch.$current.funcsBase"
		report "unstacked $current (was '$old'); it follows $primary again."
		exit 0
	fi

	# --- no base -------------------------------------------------------------

	recordNone() {
		git config --local "branch.$current.funcsBase" none
		report "recorded $current with no base; 'git resync' will not rebase it."
		exit 0
	}

	[ $setNone -eq 1 ] && recordNone
	case "$(printf '%s' "$baseArg" | tr '[:upper:]' '[:lower:]')" in
		none) recordNone ;;
	esac

	# --- stack on a base -----------------------------------------------------

	case "$baseArg" in
		"."|"@") base=$current ;;
		*)       base=$baseArg ;;
	esac

	if [ "$base" = "$current" ] || [ "$base" = "refs/heads/$current" ]; then
		echo >&2 "git-stack: a branch cannot be its own base."
		exit 1
	fi

	if ! git rev-parse --verify --quiet "refs/heads/$base" >/dev/null 2>&1 \
		&& ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1; then
		echo >&2 "git-stack: base '$base' does not resolve to a branch or ref."
		exit 1
	fi

	# A base that is a local branch is a stack parent, so it must not lead back
	# here: git-resync refuses to guess on a cycle, and it is cheaper to catch
	# that now than to leave the stack unresyncable.
	if git rev-parse --verify --quiet "refs/heads/$base" >/dev/null 2>&1; then
		walk=$base
		seen=" $base "
		while :; do
			next=$(getBranchBase "$walk")
			[ -n "$next" ] || break
			if [ "$next" = "$current" ] || [ "$next" = "refs/heads/$current" ]; then
				echo >&2 "git-stack: '$base' is already stacked on '$current', directly" \
					"or through its parents; stacking it here would make a cycle."
				exit 1
			fi
			case "$seen" in
				*" $next "*) break ;;
			esac
			seen="$seen$next "
			git rev-parse --verify --quiet "refs/heads/$next" >/dev/null 2>&1 || break
			walk=$next
		done
	fi

	git config --local "branch.$current.funcsBase" "$base"

	kv=$(resolveBase "$current")
	case "${kv%% *}" in
		branch)
			report "stacked $current on $base; 'git resync' restacks the whole stack."
			;;
		*)
			report "pinned $current to $base; 'git resync' rebases onto it, not the primary."
			;;
	esac
	exit 0
fi

# ==== show the stack =====================================================

myKv=$(resolveBase "$current")
myKind=${myKv%% *}
myVal=${myKv#* }
myChildren=$(getBranchChildren "$current" 2>/dev/null || :)

if [ -z "$myChildren" ]; then
	case "$myKind" in
		primary)
			[ $q -eq 0 ] && echo "$current (not stacked; base: $primary)"
			exit 0
			;;
		none)
			[ $q -eq 0 ] && echo "$current (pinned; no base)"
			exit 0
			;;
		ref)
			[ $q -eq 0 ] && echo "$current (not stacked; pinned base: $myVal)"
			exit 0
			;;
	esac
fi

# Find the stack root by walking funcsBase upward from $1, read-only: the walk
# stops at the first branch whose base is not another local branch, recording
# what the stack is maintained against in $rootKind/$rootBase. Warns (but does
# not repair) a dangling base, and errors on a cycle. Sets $root, $rootKind,
# $rootBase, $rootDangling (0/1), $rootMissingBase.
findRoot() {
	b=$1
	seen=" $b "
	rootDangling=0
	rootMissingBase=""
	while :; do
		kv=$(resolveBase "$b")
		kind=${kv%% *}
		p=${kv#* }
		case "$kind" in
			primary|none|ref)
				root=$b; rootKind=$kind; rootBase=$p
				return 0
				;;
			dangling)
				echo >&2 "warning: branch '$b' has funcsBase '$p', which no longer exists"
				root=$b
				rootKind=none
				rootBase=$p
				rootDangling=1
				rootMissingBase=$p
				return 0
				;;
		esac
		case "$seen" in
			*" $p "*)
				echo >&2 "git-stack: cycle detected in funcsBase chain" \
					"($seen$p ...); refusing to guess."
				exit 1
				;;
		esac
		seen="$seen$p "
		b=$p
	done
}

findRoot "$current"

# What the stack is maintained against, and the ref [merged] is checked
# against. Empty means the root is pinned to nothing, so neither applies.
case "$rootKind" in
	primary) targetRef=$primary ;;
	ref)     targetRef=$rootBase ;;
	*)       targetRef="" ;;
esac

printSeen=" $root "

printNode() {
	name=$1
	depth=$2
	sha=$(git rev-parse --short "refs/heads/$name")
	marker=""
	[ "$name" = "$current" ] && marker="$marker *"
	if [ -n "$targetRef" ] && isMergedInto "$targetRef" "refs/heads/$name"; then
		marker="$marker [merged]"
	fi
	if [ "$name" = "$root" ] && [ "$rootDangling" -eq 1 ]; then
		marker="$marker [base missing]"
	fi
	indent=""
	i=0
	while [ "$i" -lt "$depth" ]; do
		indent="$indent  "
		i=$((i + 1))
	done
	printf '%s%s %s%s\n' "$indent" "$name" "$sha" "$marker"
	children=$(getBranchChildren "$name" 2>/dev/null | sort || :)
	for c in $children; do
		case "$printSeen" in
			*" $c "*) continue ;;
		esac
		printSeen="$printSeen$c "
		printNode "$c" $((depth + 1))
	done
}

[ $q -eq 1 ] && exit 0

if [ -n "$targetRef" ]; then
	echo "$targetRef"
elif [ "$rootDangling" -eq 1 ]; then
	echo "$rootMissingBase (unresolved)"
else
	echo "(no base)"
fi
printNode "$root" 1
